<section class="aub aub-band aub-band--card aub-band--rule">
  <div class="aub-wrap">
    <div class="aub-fit">
      <div class="aub-fit__col">
        <h2 class="aub-h3">It's for you if</h2>
        <ul class="aub-plain">
          <li>your hair feels finer and flatter than it used to</li>
          <li>your part looks wider</li>
          <li>your scalp feels dry or tight, flaky, or weighed down by products</li>
          <li>you want a routine you can actually stick to</li>
        </ul>
      </div>
      <div class="aub-fit__col">
        <h2 class="aub-h3">It's not the right fit if</h2>
        <ul class="aub-plain">
          <li>you're looking for a medical treatment for hair loss. Please see a dermatologist.</li>
          <li>you have a diagnosed scalp condition</li>
          <li>the skin on your scalp is irritated or broken</li>
        </ul>
      </div>
    </div>
    <p class="aub-note">Before first use, test both products on the inside of your arm. Avoid contact with the eyes.</p>
  </div>
</section>

{% schema %}
{
  "name": "Aubury for / not for",
  "settings": [],
  "presets": [{ "name": "Aubury for / not for" }]
}
{% endschema %}
