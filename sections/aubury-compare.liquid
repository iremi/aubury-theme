<section class="aub aub-band">
  <div class="aub-wrap aub-wrap--narrow">
    <div class="aub-head">
      <h2 class="aub-h2">Why two steps</h2>
      <p class="aub-lede">An oil on its own nourishes, but leaves the buildup where it is. A peel on its own clears, but doesn't care. The routine does both.</p>
    </div>

    <table class="aub-compare">
      <thead>
        <tr>
          <td></td>
          <th scope="col">An oil with rosemary alone</th>
          <th scope="col">A shampoo-style scalp peel</th>
          <th scope="col" class="aub-compare__us">The Scalp Routine</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Removes buildup on the scalp</th>
          <td>–</td>
          <td>partly</td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span><span class="aub-compare__detail">lactic-acid serum</span></td>
        </tr>
        <tr>
          <th scope="row">Nourishes scalp and hair</th>
          <td><span class="aub-yes" role="img" aria-label="Yes"></span></td>
          <td>–</td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span><span class="aub-compare__detail">organic scalp oil</span></td>
        </tr>
        <tr>
          <th scope="row">Washed out, no greasy roots</th>
          <td>depends</td>
          <td><span class="aub-yes" role="img" aria-label="Yes"></span></td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span><span class="aub-compare__detail">both steps</span></td>
        </tr>
        <tr>
          <th scope="row">For fuller-looking hair</th>
          <td><span class="aub-yes" role="img" aria-label="Yes"></span></td>
          <td>–</td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span></td>
        </tr>
        <tr>
          <th scope="row">Fragrance-free option for sensitive scalps</th>
          <td>depends</td>
          <td>depends</td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span><span class="aub-compare__detail">step 1</span></td>
        </tr>
        <tr>
          <th scope="row">Certified natural (COSMOS)</th>
          <td>depends</td>
          <td>depends</td>
          <td class="aub-compare__us"><span class="aub-yes" role="img" aria-label="Yes"></span><span class="aub-compare__detail">both</span></td>
        </tr>
      </tbody>
    </table>
    <p class="aub-small" style="margin-top: 1rem">A comparison of product types, not of specific brands. "Depends" means it varies from product to product.</p>
  </div>
</section>

{% schema %}
{
  "name": "Aubury comparison",
  "settings": [],
  "presets": [{ "name": "Aubury comparison" }]
}
{% endschema %}
